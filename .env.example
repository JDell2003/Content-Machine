# Copy to .env and fill in. .env is gitignored.
CM_PIN=000000
CM_SESSION_SECRET=change-me-to-a-long-random-hex-string

CM_HOST=0.0.0.0
CM_PORT=3000

# auto | cli | api
CM_BRAIN=auto
ANTHROPIC_API_KEY=
CM_RANK_MODEL=opus
CM_CAPTION_MODEL=sonnet
CM_BRAIN_TIMEOUT_S=900

CM_WHISPER_MODEL=medium
CM_WHISPER_DEVICE=auto
CM_WHISPER_COMPUTE=auto

CM_CLIP_MIN_S=30
CM_CLIP_MAX_S=80
CM_MAKE_VERTICAL=1
